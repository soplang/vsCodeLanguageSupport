{
  "name": "soplang",
  "displayName": "Soplang",
  "description": "Soplang 3.6 language tools, compiler diagnostics, schema support, and execution.",
  "version": "1.1.0",
  "publisher": "soplang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/soplang/vsCodeLanguageSupport"
  },
  "bugs": {
    "url": "https://github.com/soplang/vsCodeLanguageSupport/issues"
  },
  "homepage": "https://github.com/soplang/vsCodeLanguageSupport",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/soplang-icon.png",
  "contributes": {
    "configuration": {
      "title": "Soplang",
      "properties": {
        "soplang.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Report compiler frontend diagnostics without executing source.",
          "scope": "resource"
        },
        "soplang.strict": {
          "type": "boolean",
          "default": false,
          "description": "Use the compiler strict static type mode.",
          "scope": "resource"
        },
        "soplang.compilerPath": {
          "type": "string",
          "default": "soplang",
          "scope": "resource",
          "restricted": true,
          "description": "Soplang 3 executable path or command on the extension host PATH."
        },
        "soplang.serverPath": {
          "type": "string",
          "default": "",
          "restricted": true,
          "description": "Optional path to a legacy bundled-compatible analysis server. Leave empty to use the installed Soplang 3.6 language server when available."
        },
        "soplang.workingDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "restricted": true,
          "description": "Task working directory. Relative paths use the selected workspace folder; default is that folder or the source directory."
        },
        "soplang.build.output": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Build output path relative to the working directory. Empty uses the compiler default."
        },
        "soplang.build.optimization": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3
          ],
          "default": 2,
          "scope": "resource",
          "description": "LLVM build optimization level."
        },
        "soplang.analysis.maxFileBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 4194304,
          "default": 1048576,
          "description": "Maximum source bytes per analyzed document or import."
        }
      }
    },
    "languages": [
      {
        "id": "soplang",
        "aliases": [
          "Soplang",
          "soplang"
        ],
        "extensions": [
          ".so",
          ".sop"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "images/soplang-logo.svg",
          "dark": "images/soplang-logo.svg"
        }
      },
      {
        "id": "soplang-schema",
        "aliases": [
          "Soplang Schema"
        ],
        "filenames": [
          "schema.sop"
        ],
        "configuration": "./schema-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "soplang",
        "scopeName": "source.soplang",
        "path": "./syntaxes/soplang.tmLanguage.json"
      },
      {
        "language": "soplang-schema",
        "scopeName": "source.soplang-schema",
        "path": "./syntaxes/schema.tmLanguage.json"
      }
    ],
    "keybindings": [
      {
        "command": "soplang.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == soplang || resourceExtname == .sop || resourceExtname == .so"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .sop || resourceExtname == .so",
          "command": "soplang.runFile",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname == .sop || resourceExtname == .so",
          "command": "soplang.runFile",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .sop || resourceExtname == .so",
          "command": "soplang.runFile",
          "group": "navigation"
        }
      ]
    },
    "snippets": [
      {
        "language": "soplang",
        "path": "./snippets/soplang.json"
      },
      {
        "language": "soplang-schema",
        "path": "./snippets/schema.json"
      }
    ],
    "cSpell.dictionaries": [
      {
        "name": "soplang",
        "description": "Soplang programming language keywords and syntax terms.",
        "path": "./dictionaries/soplang.txt"
      }
    ],
    "commands": [
      {
        "command": "soplang.runFile",
        "title": "Soplang: Run File"
      },
      {
        "command": "soplang.buildFile",
        "title": "Soplang: Build File"
      },
      {
        "command": "soplang.openRepl",
        "title": "Soplang: Open REPL"
      },
      {
        "command": "soplang.stop",
        "title": "Soplang: Stop"
      },
      {
        "command": "soplang.compilerStatus",
        "title": "Soplang: Compiler Status"
      },
      {
        "command": "soplang.restartServer",
        "title": "Soplang: Restart Language Server"
      },
      {
        "command": "soplang.formatDocument",
        "title": "Soplang: Format Document"
      }
    ],
    "problemMatchers": [
      {
        "name": "soplang",
        "owner": "soplang",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^\\s*--> (.+):(\\d+):(\\d+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 0
        }
      }
    ]
  },
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "tsc -p . --noEmit && node scripts/build.cjs",
    "check": "tsc -p . --noEmit",
    "build:server": "node scripts/build-server.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:server": "cargo test --locked --manifest-path server/Cargo.toml",
    "test:host": "node tests/run-host.cjs",
    "generate": "node scripts/generate.cjs",
    "vscode:prepublish": "npm run build && node scripts/check-assets.cjs",
    "package": "vsce package --no-dependencies",
    "verify:package": "node scripts/verify-package.cjs",
    "lint": "npm run check && cargo clippy --locked --manifest-path server/Cargo.toml -- -D warnings"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "activationEvents": [
    "onLanguage:soplang",
    "onLanguage:soplang-schema"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Execution and external server paths require Workspace Trust. Bundled analysis does not execute source."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Native analysis and compiler tasks require a filesystem workspace."
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "overrides": {
    "@azure/msal-node": "7.1.0"
  }
}
