{
  "Variable": {
    "prefix": "door",
    "body": [
      "door ${1:name} = ${2:0}"
    ],
    "description": "Variable"
  },
  "Constant": {
    "prefix": "madoor",
    "body": [
      "madoor ${1:name} = ${2:0}"
    ],
    "description": "Constant"
  },
  "Typed function": {
    "prefix": "hawl",
    "body": [
      "hawl ${1:add}(abn ${2:a}, abn ${3:b}): abn {",
      "\tceli ${2:a} + ${3:b}",
      "}"
    ],
    "description": "Typed function"
  },
  "Closure": {
    "prefix": "closure",
    "body": [
      "door ${1:double} = hawl(abn ${2:x}): abn {",
      "\tceli ${2:x} * 2",
      "}"
    ],
    "description": "Closure"
  },
  "Conditional": {
    "prefix": "haddii",
    "body": [
      "haddii (${1:run}) {",
      "\t${2:qor(\"yes\")}",
      "} kale {",
      "\t${3:qor(\"no\")}",
      "}"
    ],
    "description": "Conditional"
  },
  "Numeric loop": {
    "prefix": "kuceli",
    "body": [
      "kuceli (${1:i} ${2:0} ilaa ${3:10}) {",
      "\tqor(${1:i})",
      "}"
    ],
    "description": "Numeric loop"
  },
  "While": {
    "prefix": "intay",
    "body": [
      "intay (${1:been}) {",
      "\t${2:jooji}",
      "}"
    ],
    "description": "While"
  },
  "Class": {
    "prefix": "qaab",
    "body": [
      "qaab ${1:Person} {",
      "\thawl dhis(qoraal ${2:name}) {",
      "\t\tnafta.${2:name} = ${2:name}",
      "\t}",
      "}"
    ],
    "description": "Class"
  },
  "Inheritance": {
    "prefix": "dhaxal",
    "body": [
      "qaab ${1:Child} dhaxal ${2:Parent} {",
      "\thawl ${3:greet}(): qoraal {",
      "\t\tceli waalid.${3:greet}()",
      "\t}",
      "}"
    ],
    "description": "Inheritance"
  },
  "Construction": {
    "prefix": "cusub",
    "body": [
      "door ${1:person} = cusub ${2:Person}(${3:\"Asha\"})"
    ],
    "description": "Construction"
  },
  "Class annotation": {
    "prefix": "class-type",
    "body": [
      "${1:Person} ${2:person} = cusub ${1:Person}(${3:\"Asha\"})"
    ],
    "description": "Class annotation"
  },
  "Try catch": {
    "prefix": "tijaabi",
    "body": [
      "tijaabi {",
      "\t${1:qor(1 / 0)}",
      "} qabo (${2:error}) {",
      "\tqor(${2:error})",
      "}"
    ],
    "description": "Try catch"
  },
  "Import": {
    "prefix": "keen",
    "body": [
      "keen \"${1:library.sop}\""
    ],
    "description": "Import"
  },
  "List map": {
    "prefix": "aaddin",
    "body": [
      "teed ${1:result} = ${2:[1, 2]}.aaddin(hawl(abn ${3:item}): abn {",
      "\tceli ${3:item} * 2",
      "})"
    ],
    "description": "List map"
  },
  "List reduce": {
    "prefix": "ururi",
    "body": [
      "door ${1:total} = ${2:[1, 2]}.ururi(hawl(${3:sum}, ${4:item}) {",
      "\tceli ${3:sum} + ${4:item}",
      "}, 0)"
    ],
    "description": "List reduce"
  },
  "List": {
    "prefix": "teed",
    "body": [
      "teed ${1:items} = [${2:1, 2, 3}]"
    ],
    "description": "List"
  },
  "Object": {
    "prefix": "walax",
    "body": [
      "walax ${1:record} = {${2:name}: ${3:\"Asha\"}}"
    ],
    "description": "Object"
  }
}
