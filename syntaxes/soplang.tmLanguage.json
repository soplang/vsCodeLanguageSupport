{
  "name": "Soplang",
  "scopeName": "source.soplang",
  "patterns": [
    {
      "name": "comment.line.double-slash.soplang",
      "begin": "//",
      "end": "$"
    },
    {
      "name": "comment.block.soplang",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.soplang",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "string.quoted.soplang",
      "begin": "'",
      "end": "'"
    },
    {
      "name": "entity.name.function.soplang",
      "match": "(?<=hawl)\\s+[\\p{L}_][\\p{L}\\p{N}_]*"
    },
    {
      "name": "entity.name.type.class.soplang",
      "match": "(?<=qaab)\\s+[\\p{L}_][\\p{L}\\p{N}_]*"
    },
    {
      "name": "support.function.method.soplang",
      "match": "(?<=\\.)\\s*(?:aaddin|dambe|dhammaan|dherer|dhig|geli|habee|hel|hore|isku_gee|jar|ka_saar|kasaar|koowaad|kudar|leeyahay|midee|muuji|nadiifi|nuqul|qaar|raadi|rog|saar|shaandhee|tiri|ugu_dambeeya|ururi|furayaal|fure|ka_qaad|lamaane|lammaanayaal|qiimayaal|qiime|tir|beddel|beddel_dhammaan|bilow|dhamaad|dhammaad|ku_celi|kuceli|masax|masax_bilow|masax_dhamaad|masax_dhammaad|qeybi|raadi_dambe|weynee|xarafaha_weyn|xarfaha_waaweyn|xarfaha_yaryar|xiriiri|yaree)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.control.soplang",
      "match": "(?<![\\p{L}\\p{N}_])(?:celi|cusub|dhaxal|door|dooro|fasax|haddii|haddii_kale|hawl|intay|jooji|keen|kuceli|madoor|nafta|qaab|qabo|soco|ugudambeyn|waalid|xaalad)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.control.contextual.soplang",
      "match": "(?<![\\p{L}\\p{N}_])(?:tijaabi)(?![\\p{L}\\p{N}_])(?=\\s*\\{)|(?<![\\p{L}\\p{N}_])(?:kale)(?![\\p{L}\\p{N}_])(?=\\s*\\{|\\s*\\([^{}]*\\)\\s*\\{)|(?<![\\p{L}\\p{N}_])(?:ilaa)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.language.soplang",
      "match": "(?<![\\p{L}\\p{N}_])(?:run|been|maran|null)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "support.function.soplang",
      "match": "(?<![\\p{L}\\p{N}_])(?:abn|awood|baaxad|bool|daji|dhammeystir|dherer|duub|gelin|jajab|jibbaar|kor|nooc|qor|qoraal|sugan|teed|ugu_weyn|ugu_yar|walax|weyn|xidid|xul|yar)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.numeric.soplang",
      "match": "(?<![\\p{L}\\p{N}_])\\d+(?:\\.\\d+)?"
    },
    {
      "name": "keyword.operator.soplang",
      "match": "==|!=|>=|<=|&&|\\|\\||[+*/%!=<>-]"
    },
    {
      "name": "variable.other.soplang",
      "match": "[\\p{L}_][\\p{L}\\p{N}_]*"
    }
  ]
}
